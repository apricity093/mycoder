# Copy this file to .env and configure one active provider.
# CLI --provider, --model, and --base-url still take precedence.

# APRICITY_PROVIDER accepts these case-insensitive values; lowercase is canonical:
# PROVIDER_CHOICES = ("ollama", "openai", "anthropic", "deepseek")
#   ollama    - Local Ollama; no API key required; model and base URL are required
#   openai    - OpenAI Responses API; API key required; model and base URL are required
#   anthropic - Anthropic Messages API; API key required; model and base URL are required
#   deepseek  - DeepSeek native Chat Completions API with automatic cache telemetry;
#               API key required; model and base URL are required
# Keep one provider active. For example: APRICITY_PROVIDER=deepseek
APRICITY_PROVIDER=deepseek
APRICITY_MODEL=deepseek-v4-pro
APRICITY_BASE_URL=https://api.deepseek.com
APRICITY_API_KEY=

# Optional comma-separated extra env names to redact from traces and reports.
APRICITY_SECRET_ENV_NAMES=
